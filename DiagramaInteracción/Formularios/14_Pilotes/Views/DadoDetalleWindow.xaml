<Window x:Class="DadoDetalleWindow"
        Icon="pack://application:,,,/ARCO;component/Resources/ARCO_ICONOGRIS.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ARCO"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Detalle del apoyo"
        Width="1180" Height="780"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushFondoApp}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ARCO;component/Formularios/Inicio/Theme.Claro.xaml"/>
                <ResourceDictionary Source="/ARCO;component/Formularios/Inicio/Styles.xaml"/>
                <ResourceDictionary Source="/ARCO;component/Formularios/14_Pilotes/Resources/Pilotes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:CDColorConverter       x:Key="CDColor"/>
            <local:CDTextConverter        x:Key="CDTexto"/>
            <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═════════════════ TOPBAR ═════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BrushTopBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding Titulo}"
                               FontFamily="{DynamicResource FuenteDisplay}" FontSize="16"
                               Foreground="{DynamicResource BrushTopBarTexto}"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource BrushTopBarDivisor}"
                               Margin="14,0,14,0"/>
                    <TextBlock Text="{Binding SubtituloOrigen}" FontSize="12"
                               Foreground="{DynamicResource BrushTopBarTextoTenue}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource BrushTopBarTextoTenue}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SubtituloDado}" FontSize="12"
                               Foreground="{DynamicResource BrushTopBarTextoTenue}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " FontSize="12"
                               Foreground="{DynamicResource BrushTopBarTextoTenue}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SubtituloCoords}" FontSize="12"
                               Foreground="{DynamicResource BrushTopBarTextoTenue}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource BtnIconoTopBar}" Click="BtnCerrar_Click" ToolTip="Cerrar">
                        <Path Data="M 4,4 L 14,14 M 14,4 L 4,14"
                              Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.5"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════ BODY ═════════════════ -->
        <TabControl Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
        <TabItem Header="Geotécnico">
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KPIs globales del apoyo -->
            <UniformGrid Grid.Row="0" Grid.ColumnSpan="3" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource CardKPI}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Pu MAX COMPRESIÓN" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Pu_Max, StringFormat={}{0:0}}" FontSize="26"
                                       FontFamily="{DynamicResource FuenteDisplay}"
                                       Foreground="{DynamicResource BrushAzulPrincipal}"/>
                            <TextBlock Text=" kN" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,6"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Combo_Gob_Compresion, StringFormat='combo {0}'}" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardKPI}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Pu MIN (tracción si &lt; 0)" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Pu_Min, StringFormat={}{0:0}}" FontSize="26"
                                       FontFamily="{DynamicResource FuenteDisplay}"
                                       Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            <TextBlock Text=" kN" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,6"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Combo_Gob_Traccion, StringFormat='combo {0}'}" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardKPI}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="C/D COMPRESIÓN" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"/>
                        <Border Background="{Binding CD_Compresion, Converter={StaticResource CDColor}}"
                                CornerRadius="4" Padding="10,2" HorizontalAlignment="Left" Margin="0,4">
                            <TextBlock Text="{Binding CD_Compresion, Converter={StaticResource CDTexto}}"
                                       FontSize="22" Foreground="White"
                                       FontFamily="{DynamicResource FuenteDisplay}"/>
                        </Border>
                        <TextBlock Text="Umbral ≥ 0.90" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardKPI}">
                    <StackPanel>
                        <TextBlock Text="C/D TRACCIÓN" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"/>
                        <Border Background="{Binding CD_Traccion, Converter={StaticResource CDColor}}"
                                CornerRadius="4" Padding="10,2" HorizontalAlignment="Left" Margin="0,4">
                            <TextBlock Text="{Binding CD_Traccion, Converter={StaticResource CDTexto}}"
                                       FontSize="22" Foreground="White"
                                       FontFamily="{DynamicResource FuenteDisplay}"/>
                        </Border>
                        <TextBlock Text="— si no hay tracción" FontSize="11"
                                   Foreground="{DynamicResource BrushTextoSecundario}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Mini-planta del dado -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Planta del dado"
                               FontFamily="{DynamicResource FuenteDisplay}" FontSize="15"
                               Foreground="{DynamicResource BrushTextoPrincipal}"
                               Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Background="{DynamicResource BrushCanvasFondo}"
                            BorderBrush="{DynamicResource BrushBorde}" BorderThickness="1"
                            CornerRadius="4" ClipToBounds="True">
                        <Canvas x:Name="CanvasDado" Background="Transparent"
                                SizeChanged="CanvasDado_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Columna derecha: dos tablas apiladas -->
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Resumen por pilote -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resumen por pilote"
                                       FontFamily="{DynamicResource FuenteDisplay}" FontSize="15"
                                       Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            <TextBlock Grid.Column="1" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding NumPilotes, Mode=OneWay}"/>
                                <Run Text="pilotes · "/>
                                <Run Text="{Binding NumCombinaciones, Mode=OneWay}"/>
                                <Run Text="combinaciones evaluadas"/>
                            </TextBlock>
                        </Grid>
                        <DataGrid ItemsSource="{Binding ResumenPorPilote}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BrushBordeTenue}"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeight="30" FontSize="12"
                                  AlternatingRowBackground="{DynamicResource BrushBordeTenue}"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Numero}" Width="40"/>
                                <DataGridTextColumn Header="X [m]" Binding="{Binding X_Local, StringFormat={}{0:0.00}}" Width="70"/>
                                <DataGridTextColumn Header="Y [m]" Binding="{Binding Y_Local, StringFormat={}{0:0.00}}" Width="70"/>
                                <DataGridTextColumn Header="Pu max [kN]" Binding="{Binding Pu_Max, StringFormat={}{0:0}}" Width="90"/>
                                <DataGridTextColumn Header="Combo max" Binding="{Binding Combo_Max}" Width="130"/>
                                <DataGridTextColumn Header="Pu min [kN]" Binding="{Binding Pu_Min, StringFormat={}{0:0}}" Width="90"/>
                                <DataGridTextColumn Header="Combo min" Binding="{Binding Combo_Min}" Width="130"/>
                                <DataGridTemplateColumn Header="C/D comp" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2" CornerRadius="4" HorizontalAlignment="Center"
                                                    Background="{Binding CD_Compresion, Converter={StaticResource CDColor}}"
                                                    Margin="0,3">
                                                <TextBlock Text="{Binding CD_Compresion, Converter={StaticResource CDTexto}}"
                                                           Foreground="White" FontSize="11"
                                                           FontFamily="{DynamicResource FuenteDisplay}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="C/D tracc" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2" CornerRadius="4" HorizontalAlignment="Center"
                                                    Background="{Binding CD_Traccion, Converter={StaticResource CDColor}}"
                                                    Margin="0,3">
                                                <TextBlock Text="{Binding CD_Traccion, Converter={StaticResource CDTexto}}"
                                                           Foreground="White" FontSize="11"
                                                           FontFamily="{DynamicResource FuenteDisplay}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Matriz combinaciones × pilotes -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fuerzas por pilote y por combinación"
                                       FontFamily="{DynamicResource FuenteDisplay}" FontSize="15"
                                       Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            <TextBlock Grid.Column="1" Text="★ = combinación que gobierna el C/D" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="GridMatriz"
                                  AutoGenerateColumns="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="{DynamicResource BrushBordeTenue}"
                                  VerticalGridLinesBrush="{DynamicResource BrushBordeTenue}"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeight="28" FontSize="11"
                                  AlternatingRowBackground="{DynamicResource BrushBordeTenue}"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        </TabItem>

        <!-- ═════════════════ PESTAÑA STM (NSR-10 C.23) ═════════════════ -->
        <TabItem Header="STM (NSR-10 C.23)">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPIs del STM -->
                <UniformGrid Grid.Row="0" Grid.ColumnSpan="3" Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource CardKPI}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="C/D PUNTAL (mín)" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                            <Border Background="{Binding CD_STM_Puntal, Converter={StaticResource CDColor}}"
                                    CornerRadius="4" Padding="10,2" HorizontalAlignment="Left" Margin="0,4">
                                <TextBlock Text="{Binding CD_STM_Puntal, Converter={StaticResource CDTexto}}"
                                           FontSize="22" Foreground="White"
                                           FontFamily="{DynamicResource FuenteDisplay}"/>
                            </Border>
                            <TextBlock Text="φFns / F_puntal · φ=0.75" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardKPI}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="C/D NODO (mín)" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                            <Border Background="{Binding CD_STM_Nodo, Converter={StaticResource CDColor}}"
                                    CornerRadius="4" Padding="10,2" HorizontalAlignment="Left" Margin="0,4">
                                <TextBlock Text="{Binding CD_STM_Nodo, Converter={StaticResource CDTexto}}"
                                           FontSize="22" Foreground="White"
                                           FontFamily="{DynamicResource FuenteDisplay}"/>
                            </Border>
                            <TextBlock Text="CCC / CCT · βn 1.0 / 0.80" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardKPI}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="C/D TENSOR X" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                            <Border Background="{Binding CD_STM_Tensor_X, Converter={StaticResource CDColor}}"
                                    CornerRadius="4" Padding="10,2" HorizontalAlignment="Left" Margin="0,4">
                                <TextBlock Text="{Binding CD_STM_Tensor_X, Converter={StaticResource CDTexto}}"
                                           FontSize="22" Foreground="White"
                                           FontFamily="{DynamicResource FuenteDisplay}"/>
                            </Border>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}">
                                <Run Text="As req "/>
                                <Run Text="{Binding As_STM_X, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                                <Run Text=" / prov "/>
                                <Run Text="{Binding As_STM_X_Provisto, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                                <Run Text=" cm²"/>
                            </TextBlock>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"
                                       Text="{Binding Refuerzo_X_Resumen}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardKPI}">
                        <StackPanel>
                            <TextBlock Text="C/D TENSOR Y" FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"/>
                            <Border Background="{Binding CD_STM_Tensor_Y, Converter={StaticResource CDColor}}"
                                    CornerRadius="4" Padding="10,2" HorizontalAlignment="Left" Margin="0,4">
                                <TextBlock Text="{Binding CD_STM_Tensor_Y, Converter={StaticResource CDTexto}}"
                                           FontSize="22" Foreground="White"
                                           FontFamily="{DynamicResource FuenteDisplay}"/>
                            </Border>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}">
                                <Run Text="As req "/>
                                <Run Text="{Binding As_STM_Y, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                                <Run Text=" / prov "/>
                                <Run Text="{Binding As_STM_Y_Provisto, StringFormat={}{0:0.0}, Mode=OneWay}"/>
                                <Run Text=" cm²"/>
                            </TextBlock>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource BrushTextoSecundario}"
                                       Text="{Binding Refuerzo_Y_Resumen}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Diagrama en elevación del modelo STM -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Elevación del modelo puntal-tensor"
                                       FontFamily="{DynamicResource FuenteDisplay}" FontSize="15"
                                       Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="L/h = " FontSize="11"
                                           Foreground="{DynamicResource BrushTextoSecundario}"/>
                                <TextBlock Text="{Binding RelacionLH, StringFormat={}{0:0.00}}" FontSize="11"
                                           FontFamily="{DynamicResource FuenteDisplay}"
                                           Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource BrushCanvasFondo}"
                                BorderBrush="{DynamicResource BrushBorde}" BorderThickness="1"
                                CornerRadius="4" ClipToBounds="True">
                            <Canvas x:Name="CanvasSTM" Background="Transparent"
                                    SizeChanged="CanvasSTM_SizeChanged"/>
                        </Border>
                        <TextBlock Grid.Row="2" Text="{Binding AdvertenciasSTM}"
                                   Foreground="{DynamicResource BrushAdvertencia}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding DadoEsbelto, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </Border>

                <!-- Tablas apiladas: puntales + tensores + nodos -->
                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Puntales -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Puntales" Margin="0,0,0,8"
                                       FontFamily="{DynamicResource FuenteDisplay}" FontSize="14"
                                       Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            <DataGrid ItemsSource="{Binding Puntales}"
                                      AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BrushBordeTenue}"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeight="26" FontSize="11"
                                      AlternatingRowBackground="{DynamicResource BrushBordeTenue}"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="θ [°]"    Binding="{Binding Angulo, StringFormat={}{0:0.0}}" Width="60"/>
                                    <DataGridTextColumn Header="L [m]"    Binding="{Binding Longitud, StringFormat={}{0:0.00}}" Width="70"/>
                                    <DataGridTextColumn Header="F [kN]"   Binding="{Binding Fuerza, StringFormat={}{0:0}}"   Width="80"/>
                                    <DataGridTextColumn Header="ws [m]"   Binding="{Binding AnchoPuntal, StringFormat={}{0:0.000}}" Width="70"/>
                                    <DataGridTextColumn Header="Acs [m²]" Binding="{Binding Acs, StringFormat={}{0:0.000}}"   Width="80"/>
                                    <DataGridTextColumn Header="φFns [kN]" Binding="{Binding PhiFns, StringFormat={}{0:0}}"   Width="85"/>
                                    <DataGridTemplateColumn Header="C/D" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2" CornerRadius="4" HorizontalAlignment="Center"
                                                        Background="{Binding CD, Converter={StaticResource CDColor}}"
                                                        Margin="0,2">
                                                    <TextBlock Text="{Binding CD, Converter={StaticResource CDTexto}}"
                                                               Foreground="White" FontSize="11"
                                                               FontFamily="{DynamicResource FuenteDisplay}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Tensores -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tensores (refuerzo inferior)" Margin="0,0,0,8"
                                       FontFamily="{DynamicResource FuenteDisplay}" FontSize="14"
                                       Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            <DataGrid ItemsSource="{Binding Tensores}"
                                      AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BrushBordeTenue}"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeight="26" FontSize="11"
                                      AlternatingRowBackground="{DynamicResource BrushBordeTenue}"
                                      MaxHeight="130">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dir"    Binding="{Binding Direccion}" Width="60"/>
                                    <DataGridTextColumn Header="L [m]"  Binding="{Binding Longitud, StringFormat={}{0:0.00}}" Width="80"/>
                                    <DataGridTextColumn Header="F [kN]" Binding="{Binding Fuerza, StringFormat={}{0:0}}" Width="90"/>
                                    <DataGridTextColumn Header="As req [cm²]" Binding="{Binding As_Requerida_cm2, StringFormat={}{0:0.0}}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Nodos -->
                    <Border Grid.Row="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Nodos" Margin="0,0,0,8"
                                       FontFamily="{DynamicResource FuenteDisplay}" FontSize="14"
                                       Foreground="{DynamicResource BrushTextoPrincipal}"/>
                            <DataGrid ItemsSource="{Binding Nodos}"
                                      AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BrushBordeTenue}"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeight="26" FontSize="11"
                                      AlternatingRowBackground="{DynamicResource BrushBordeTenue}"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nodo"    Binding="{Binding Nombre}" Width="80"/>
                                    <DataGridTextColumn Header="Tipo"    Binding="{Binding Tipo}" Width="60"/>
                                    <DataGridTextColumn Header="βn"      Binding="{Binding BetaN, StringFormat={}{0:0.00}}" Width="55"/>
                                    <DataGridTextColumn Header="Anz [m²]" Binding="{Binding AreaNodal, StringFormat={}{0:0.000}}" Width="80"/>
                                    <DataGridTextColumn Header="F [kN]"  Binding="{Binding FuerzaCompresion, StringFormat={}{0:0}}" Width="80"/>
                                    <DataGridTextColumn Header="φFn [kN]" Binding="{Binding PhiFn, StringFormat={}{0:0}}" Width="85"/>
                                    <DataGridTemplateColumn Header="C/D" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2" CornerRadius="4" HorizontalAlignment="Center"
                                                        Background="{Binding CD, Converter={StaticResource CDColor}}"
                                                        Margin="0,2">
                                                    <TextBlock Text="{Binding CD, Converter={StaticResource CDTexto}}"
                                                               Foreground="White" FontSize="11"
                                                               FontFamily="{DynamicResource FuenteDisplay}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ═════════════════ PESTAÑA 3D ═════════════════ -->
        <TabItem Header="Vista 3D">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de controles -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mostrar:" FontSize="12"
                                   Foreground="{DynamicResource BrushTextoSecundario}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="Chk3D_Dado" Content="Dado" IsChecked="True"
                                  Checked="Chk3D_Toggle" Unchecked="Chk3D_Toggle"
                                  Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="Chk3D_Pilotes" Content="Pilotes" IsChecked="True"
                                  Checked="Chk3D_Toggle" Unchecked="Chk3D_Toggle"
                                  Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="Chk3D_Columna" Content="Columna" IsChecked="True"
                                  Checked="Chk3D_Toggle" Unchecked="Chk3D_Toggle"
                                  Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="Chk3D_STM" Content="Puntales y tensores STM" IsChecked="True"
                                  Checked="Chk3D_Toggle" Unchecked="Chk3D_Toggle"
                                  Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource BtnSecundario}" Content="⟲ Ajustar vista"
                                Click="Btn3D_AjustarVista_Click" FontSize="12"
                                Padding="10,4"/>
                    </StackPanel>
                </Border>

                <!-- Viewport 3D -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <h:HelixViewport3D x:Name="Viewport3D"
                                       Background="#2B2B2B"
                                       ShowCoordinateSystem="True"
                                       ShowFrameRate="False"
                                       ShowViewCube="True"
                                       ViewCubeTopText="SUP" ViewCubeBottomText="INF"
                                       ViewCubeFrontText="FRT" ViewCubeBackText="BCK"
                                       ViewCubeLeftText="IZQ" ViewCubeRightText="DER"
                                       ZoomExtentsWhenLoaded="True">
                        <h:DefaultLights/>
                    </h:HelixViewport3D>
                </Border>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
