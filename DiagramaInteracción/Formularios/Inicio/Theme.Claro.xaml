<!-- Tema CLARO — paleta ARCO 100% GRIS con alto contraste.
     Jerarquía de 10 niveles:
       #1F1F1F texto principal · #2B2B2B acento primario · #3C3C3C acento hover
       #575757 gris ARCO (topbar/sidebar) · #6E6E6E separadores
       #8A8A8A medio · #B5B5B5 deshabilitado · #D5D5D5 bordes
       #EAEAEA borde tenue · #F2F2F2 fondo app · #FFFFFF superficie
     Keys preservadas (incluidas las que llevan "Azul" en el nombre) para no
     romper bindings existentes; solo cambian los valores. Semáforo
     (cumple/advertencia/no cumple) se mantiene porque es funcional. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Superficies ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushFondoApp"           Color="#F2F2F2"/>
    <SolidColorBrush x:Key="BrushSuperficie"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSuperficieHover"    Color="#EDEDED"/>
    <SolidColorBrush x:Key="BrushSuperficiePresion"  Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BrushSuperficieBanner"   Color="#F7F7F7"/>

    <!-- ── Sidebar (gris ARCO oficial #575757) ─────────────────── -->
    <SolidColorBrush x:Key="BrushSidebar"            Color="#575757"/>
    <SolidColorBrush x:Key="BrushSidebarHover"       Color="#6B6B6B"/>
    <SolidColorBrush x:Key="BrushSidebarActivo"      Color="#2B2B2B"/>
    <SolidColorBrush x:Key="BrushSidebarTitulo"      Color="#CFCFCF"/>
    <SolidColorBrush x:Key="BrushSidebarSeparador"   Color="#6E6E6E"/>
    <SolidColorBrush x:Key="BrushSidebarTexto"       Color="#F2F2F2"/>
    <SolidColorBrush x:Key="BrushSidebarTextoTenue"  Color="#B8B8B8"/>

    <!-- ── TopBar (mismo gris ARCO) ────────────────────────────── -->
    <SolidColorBrush x:Key="BrushTopBar"             Color="#575757"/>
    <SolidColorBrush x:Key="BrushTopBarTexto"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTopBarTextoTenue"   Color="#CFCFCF"/>
    <SolidColorBrush x:Key="BrushTopBarHover"        Color="#6B6B6B"/>
    <SolidColorBrush x:Key="BrushTopBarDivisor"      Color="#6E6E6E"/>
    <SolidColorBrush x:Key="BrushTopBarSearchFondo"  Color="#4A4A4A"/>
    <SolidColorBrush x:Key="BrushTopBarSearchFoco"   Color="#3C3C3C"/>

    <!-- ── Marca y acento (gris carbón para contraste alto) ────
         Keys preservadas por compatibilidad: BrushAzul* ahora es GRIS. -->
    <SolidColorBrush x:Key="BrushAzulPrincipal"      Color="#2B2B2B"/>
    <SolidColorBrush x:Key="BrushAzulInteraccion"    Color="#3C3C3C"/>
    <SolidColorBrush x:Key="BrushAzulTenue"          Color="#8A8A8A"/>

    <!-- ── Texto ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushTextoPrincipal"     Color="#1F1F1F"/>
    <SolidColorBrush x:Key="BrushTextoSecundario"    Color="#575757"/>
    <SolidColorBrush x:Key="BrushTextoDeshabilitado" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="BrushTextoPlaceholder"   Color="#9A9A9A"/>

    <!-- ── Bordes ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBorde"              Color="#D5D5D5"/>
    <SolidColorBrush x:Key="BrushBordeHover"         Color="#575757"/>
    <SolidColorBrush x:Key="BrushBordeTenue"         Color="#EAEAEA"/>

    <!-- ── Badges (neutros grises) ─────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBadgeFondo"         Color="#EDEDED"/>
    <SolidColorBrush x:Key="BrushBadgeBorde"         Color="#B5B5B5"/>
    <SolidColorBrush x:Key="BrushBadgeTexto"         Color="#3C3C3C"/>

    <!-- ── Sombra sutil (para elevación de tarjetas) ───────────── -->
    <DropShadowEffect x:Key="ElevacionBaja"
                      Color="#1F1F1F" Opacity="0.10"
                      BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="ElevacionMedia"
                      Color="#1F1F1F" Opacity="0.16"
                      BlurRadius="18" ShadowDepth="4" Direction="270"/>

</ResourceDictionary>
