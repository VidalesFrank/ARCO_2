<!-- Tema CLARO — paleta premium azul petróleo + neutros.
     Mismas keys en Theme.Oscuro.xaml para permitir switch en caliente. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Superficies ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushFondoApp"           Color="#F5F7FA"/>
    <SolidColorBrush x:Key="BrushSuperficie"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSuperficieHover"    Color="#EDF4FA"/>
    <SolidColorBrush x:Key="BrushSuperficiePresion"  Color="#E0ECF6"/>
    <SolidColorBrush x:Key="BrushSuperficieBanner"   Color="#F0F6FC"/>

    <!-- ── Sidebar ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushSidebar"            Color="#172B3A"/>
    <SolidColorBrush x:Key="BrushSidebarHover"       Color="#20394D"/>
    <SolidColorBrush x:Key="BrushSidebarActivo"      Color="#3273A8"/>
    <SolidColorBrush x:Key="BrushSidebarTitulo"      Color="#87A0B6"/>
    <SolidColorBrush x:Key="BrushSidebarSeparador"   Color="#28404E"/>
    <SolidColorBrush x:Key="BrushSidebarTexto"       Color="#E2ECF6"/>
    <SolidColorBrush x:Key="BrushSidebarTextoTenue"  Color="#9DB5CC"/>

    <!-- ── TopBar ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushTopBar"             Color="#172B3A"/>
    <SolidColorBrush x:Key="BrushTopBarTexto"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTopBarTextoTenue"   Color="#A6BED4"/>
    <SolidColorBrush x:Key="BrushTopBarHover"        Color="#253C50"/>
    <SolidColorBrush x:Key="BrushTopBarDivisor"      Color="#2C445A"/>
    <SolidColorBrush x:Key="BrushTopBarSearchFondo"  Color="#223B52"/>
    <SolidColorBrush x:Key="BrushTopBarSearchFoco"   Color="#2B4A66"/>

    <!-- ── Marca y acento ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushAzulPrincipal"      Color="#244A68"/>
    <SolidColorBrush x:Key="BrushAzulInteraccion"    Color="#3273A8"/>
    <SolidColorBrush x:Key="BrushAzulTenue"          Color="#8DB2CF"/>

    <!-- ── Texto ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushTextoPrincipal"     Color="#202B36"/>
    <SolidColorBrush x:Key="BrushTextoSecundario"    Color="#687786"/>
    <SolidColorBrush x:Key="BrushTextoDeshabilitado" Color="#AAB6C4"/>
    <SolidColorBrush x:Key="BrushTextoPlaceholder"   Color="#8EA6BE"/>

    <!-- ── Bordes ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBorde"              Color="#E2E8EF"/>
    <SolidColorBrush x:Key="BrushBordeHover"         Color="#3273A8"/>
    <SolidColorBrush x:Key="BrushBordeTenue"         Color="#EEF2F7"/>

    <!-- ── Badges ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBadgeFondo"         Color="#FFF3CC"/>
    <SolidColorBrush x:Key="BrushBadgeBorde"         Color="#D7AF5F"/>
    <SolidColorBrush x:Key="BrushBadgeTexto"         Color="#7C5C1E"/>

    <!-- ── Sombra sutil (para elevación de tarjetas) ───────────── -->
    <DropShadowEffect x:Key="ElevacionBaja"
                      Color="#172B3A" Opacity="0.08"
                      BlurRadius="12" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="ElevacionMedia"
                      Color="#172B3A" Opacity="0.14"
                      BlurRadius="18" ShadowDepth="4" Direction="270"/>

</ResourceDictionary>
