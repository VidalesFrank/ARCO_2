<UserControl x:Class="ModuleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="276" Height="118"
             Margin="0,0,16,16"
             Focusable="False">
    <Border x:Name="BorderRaiz"
            CornerRadius="10"
            BorderThickness="1"
            Padding="16"
            Cursor="Hand"
            SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushSuperficie}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorde}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushSuperficieHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBordeHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icono del módulo -->
            <Viewbox Grid.Column="0"
                     Width="44" Height="44"
                     HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path x:Name="IconPath"
                      Width="48" Height="48"
                      Stretch="Uniform"
                      Fill="{DynamicResource BrushAzulPrincipal}"/>
            </Viewbox>

            <!-- Título + descripción -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="TitleText" Style="{DynamicResource CardTitulo}"/>
                    <Border x:Name="BadgeDisponibilidad"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="{DynamicResource BrushBadgeFondo}"
                            BorderBrush="{DynamicResource BrushBadgeBorde}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2,8,2"
                            Visibility="Collapsed">
                        <TextBlock Text="EN DESARROLLO"
                                   FontFamily="{DynamicResource FuenteDisplay}"
                                   FontSize="9"
                                   Foreground="{DynamicResource BrushBadgeTexto}"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="DescText"
                           Grid.Row="1"
                           Style="{DynamicResource CardDescripcion}"
                           Margin="0,6,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
