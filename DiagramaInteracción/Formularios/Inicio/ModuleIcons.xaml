<!-- Iconos vectoriales — Geometry resources. Diseñados en viewBox 48×48.
     Se renderizan con <Path Data="{StaticResource IcoX}" Fill="..." Stretch="Uniform"/>
     El Fill se aplica dinámicamente desde el tema (DynamicResource). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════
         MÓDULOS ESTRUCTURALES (48×48, filled silhouette)
         ══════════════════════════════════════════════════════════ -->

    <!-- Columnas: capital + fuste + base -->
    <GeometryGroup x:Key="IcoColumnas" FillRule="Nonzero">
        <RectangleGeometry Rect="9,8 30,4"/>
        <RectangleGeometry Rect="14,13 20,27"/>
        <RectangleGeometry Rect="6,40 36,5"/>
    </GeometryGroup>

    <!-- Vigas: viga + dos apoyos triangulares -->
    <GeometryGroup x:Key="IcoVigas" FillRule="Nonzero">
        <RectangleGeometry Rect="4,20 40,10"/>
        <PathGeometry>
            <PathFigure StartPoint="6,30" IsClosed="True">
                <LineSegment Point="14,30"/>
                <LineSegment Point="10,38"/>
            </PathFigure>
        </PathGeometry>
        <PathGeometry>
            <PathFigure StartPoint="34,30" IsClosed="True">
                <LineSegment Point="42,30"/>
                <LineSegment Point="38,38"/>
            </PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <!-- Muros: tres bandas horizontales (hiladas) -->
    <GeometryGroup x:Key="IcoMuros" FillRule="Nonzero">
        <RectangleGeometry Rect="9,8 30,10"/>
        <RectangleGeometry Rect="9,20 30,10"/>
        <RectangleGeometry Rect="9,32 30,10"/>
    </GeometryGroup>

    <!-- M.N.E.: patrón de mampostería con juntas escalonadas -->
    <GeometryGroup x:Key="IcoMNE" FillRule="Nonzero">
        <RectangleGeometry Rect="8,11 14,7"/>
        <RectangleGeometry Rect="24,11 14,7"/>
        <RectangleGeometry Rect="4,20 12,7"/>
        <RectangleGeometry Rect="18,20 12,7"/>
        <RectangleGeometry Rect="32,20 12,7"/>
        <RectangleGeometry Rect="8,29 14,7"/>
        <RectangleGeometry Rect="24,29 14,7"/>
        <RectangleGeometry Rect="4,38 12,5"/>
        <RectangleGeometry Rect="18,38 12,5"/>
        <RectangleGeometry Rect="32,38 12,5"/>
    </GeometryGroup>

    <!-- Zapatas: pedestal cuadrado sobre base ancha -->
    <GeometryGroup x:Key="IcoZapatas" FillRule="Nonzero">
        <RectangleGeometry Rect="20,8 8,24"/>
        <RectangleGeometry Rect="6,32 36,10"/>
    </GeometryGroup>

    <!-- Pilas: columna + fuste cilíndrico profundo + línea de terreno -->
    <GeometryGroup x:Key="IcoPilas" FillRule="Nonzero">
        <RectangleGeometry Rect="20,6 8,14"/>
        <RectangleGeometry Rect="4,20 40,2"/>
        <RectangleGeometry Rect="18,22 12,22"/>
    </GeometryGroup>

    <!-- Vigas de Fundación: viga enterrada + línea de terreno -->
    <GeometryGroup x:Key="IcoVigasFund" FillRule="Nonzero">
        <RectangleGeometry Rect="4,16 40,2"/>
        <RectangleGeometry Rect="22,8 6,10"/>
        <RectangleGeometry Rect="6,26 36,12"/>
    </GeometryGroup>

    <!-- Pilotes: dado + pilote largo esbelto -->
    <GeometryGroup x:Key="IcoPilotes" FillRule="Nonzero">
        <RectangleGeometry Rect="10,12 28,8"/>
        <RectangleGeometry Rect="4,22 8,2"/>
        <RectangleGeometry Rect="36,22 8,2"/>
        <RectangleGeometry Rect="20,22 8,22"/>
    </GeometryGroup>

    <!-- Losas: losa en perspectiva ligera -->
    <GeometryGroup x:Key="IcoLosas" FillRule="Nonzero">
        <PathGeometry>
            <PathFigure StartPoint="8,16" IsClosed="True">
                <LineSegment Point="40,16"/>
                <LineSegment Point="44,24"/>
                <LineSegment Point="4,24"/>
            </PathFigure>
        </PathGeometry>
        <PathGeometry>
            <PathFigure StartPoint="8,28" IsClosed="True">
                <LineSegment Point="40,28"/>
                <LineSegment Point="44,36"/>
                <LineSegment Point="4,36"/>
            </PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <!-- Nervios: losa superior + 4 nervios verticales -->
    <GeometryGroup x:Key="IcoNervios" FillRule="Nonzero">
        <RectangleGeometry Rect="4,12 40,6"/>
        <RectangleGeometry Rect="8,20 5,22"/>
        <RectangleGeometry Rect="18,20 5,22"/>
        <RectangleGeometry Rect="28,20 5,22"/>
        <RectangleGeometry Rect="38,20 5,22"/>
    </GeometryGroup>

    <!-- Escaleras: 4 escalones ascendentes -->
    <GeometryGroup x:Key="IcoEscaleras" FillRule="Nonzero">
        <RectangleGeometry Rect="4,36 10,6"/>
        <RectangleGeometry Rect="14,28 10,14"/>
        <RectangleGeometry Rect="24,20 10,22"/>
        <RectangleGeometry Rect="34,12 10,30"/>
    </GeometryGroup>

    <!-- Muro de Contención: zapata + vástago cantilever -->
    <GeometryGroup x:Key="IcoMContencion" FillRule="Nonzero">
        <RectangleGeometry Rect="4,34 40,6"/>
        <PathGeometry>
            <PathFigure StartPoint="22,34" IsClosed="True">
                <LineSegment Point="30,34"/>
                <LineSegment Point="30,6"/>
                <LineSegment Point="26,6"/>
            </PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <!-- MC. Cortina: pantalla vertical + apoyo superior -->
    <GeometryGroup x:Key="IcoMCCortina" FillRule="Nonzero">
        <RectangleGeometry Rect="22,8 6,32"/>
        <PathGeometry>
            <PathFigure StartPoint="15,12" IsClosed="True">
                <LineSegment Point="22,8"/>
                <LineSegment Point="22,16"/>
            </PathFigure>
        </PathGeometry>
        <RectangleGeometry Rect="12,40 26,3"/>
    </GeometryGroup>

    <!-- Análisis de Sección: sección hueca + ejes -->
    <GeometryGroup x:Key="IcoAnalisis" FillRule="Nonzero">
        <RectangleGeometry Rect="9,9 30,3"/>
        <RectangleGeometry Rect="9,36 30,3"/>
        <RectangleGeometry Rect="9,9 3,30"/>
        <RectangleGeometry Rect="36,9 3,30"/>
        <RectangleGeometry Rect="14,22 20,4"/>
        <RectangleGeometry Rect="22,14 4,20"/>
    </GeometryGroup>

    <!-- Visualizador E2K: silueta hexagonal de cubo isométrico + líneas de aristas -->
    <GeometryGroup x:Key="IcoE2K" FillRule="Nonzero">
        <PathGeometry>
            <PathFigure StartPoint="24,6" IsClosed="True">
                <LineSegment Point="42,16"/>
                <LineSegment Point="42,34"/>
                <LineSegment Point="24,44"/>
                <LineSegment Point="6,34"/>
                <LineSegment Point="6,16"/>
            </PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <!-- ══════════════════════════════════════════════════════════
         ICONOS DE UI (24×24, stroke o fill según el tipo)
         ══════════════════════════════════════════════════════════ -->

    <!-- Casa / Inicio (outline, Stroke) -->
    <PathGeometry x:Key="IcoInicio">
        <PathFigure StartPoint="2,12">
            <LineSegment Point="12,3"/>
            <LineSegment Point="22,12"/>
        </PathFigure>
        <PathFigure StartPoint="4,11" IsClosed="True">
            <LineSegment Point="4,21"/>
            <LineSegment Point="20,21"/>
            <LineSegment Point="20,11"/>
        </PathFigure>
        <PathFigure StartPoint="10,21">
            <LineSegment Point="10,14"/>
            <LineSegment Point="14,14"/>
            <LineSegment Point="14,21"/>
        </PathFigure>
    </PathGeometry>

    <!-- Grid de módulos (4 squares, filled) -->
    <GeometryGroup x:Key="IcoModulos" FillRule="Nonzero">
        <RectangleGeometry Rect="3,3 8,8" RadiusX="1.5" RadiusY="1.5"/>
        <RectangleGeometry Rect="13,3 8,8" RadiusX="1.5" RadiusY="1.5"/>
        <RectangleGeometry Rect="3,13 8,8" RadiusX="1.5" RadiusY="1.5"/>
        <RectangleGeometry Rect="13,13 8,8" RadiusX="1.5" RadiusY="1.5"/>
    </GeometryGroup>

    <!-- Carpeta de proyecto (Stroke) -->
    <PathGeometry x:Key="IcoProyecto">
        <PathFigure StartPoint="3,7" IsClosed="True">
            <LineSegment Point="10,7"/>
            <LineSegment Point="12,5"/>
            <LineSegment Point="21,5"/>
            <LineSegment Point="21,19"/>
            <LineSegment Point="3,19"/>
        </PathFigure>
    </PathGeometry>

    <!-- Informe / documento (Stroke) -->
    <PathGeometry x:Key="IcoInformes">
        <PathFigure StartPoint="5,3" IsClosed="True">
            <LineSegment Point="15,3"/>
            <LineSegment Point="20,8"/>
            <LineSegment Point="20,21"/>
            <LineSegment Point="5,21"/>
        </PathFigure>
        <PathFigure StartPoint="15,3">
            <LineSegment Point="15,8"/>
            <LineSegment Point="20,8"/>
        </PathFigure>
        <PathFigure StartPoint="8,12"><LineSegment Point="17,12"/></PathFigure>
        <PathFigure StartPoint="8,15"><LineSegment Point="17,15"/></PathFigure>
        <PathFigure StartPoint="8,18"><LineSegment Point="14,18"/></PathFigure>
    </PathGeometry>

    <!-- Engranaje de configuración (filled, simplified 8-tooth) -->
    <GeometryGroup x:Key="IcoConfig" FillRule="Nonzero">
        <PathGeometry>
            <PathFigure StartPoint="11,2" IsClosed="True">
                <LineSegment Point="13,2"/>
                <LineSegment Point="13.6,4.5"/>
                <LineSegment Point="16,5.3"/>
                <LineSegment Point="18,4"/>
                <LineSegment Point="20,6"/>
                <LineSegment Point="18.7,8"/>
                <LineSegment Point="19.5,10.4"/>
                <LineSegment Point="22,11"/>
                <LineSegment Point="22,13"/>
                <LineSegment Point="19.5,13.6"/>
                <LineSegment Point="18.7,16"/>
                <LineSegment Point="20,18"/>
                <LineSegment Point="18,20"/>
                <LineSegment Point="16,18.7"/>
                <LineSegment Point="13.6,19.5"/>
                <LineSegment Point="13,22"/>
                <LineSegment Point="11,22"/>
                <LineSegment Point="10.4,19.5"/>
                <LineSegment Point="8,18.7"/>
                <LineSegment Point="6,20"/>
                <LineSegment Point="4,18"/>
                <LineSegment Point="5.3,16"/>
                <LineSegment Point="4.5,13.6"/>
                <LineSegment Point="2,13"/>
                <LineSegment Point="2,11"/>
                <LineSegment Point="4.5,10.4"/>
                <LineSegment Point="5.3,8"/>
                <LineSegment Point="4,6"/>
                <LineSegment Point="6,4"/>
                <LineSegment Point="8,5.3"/>
                <LineSegment Point="10.4,4.5"/>
            </PathFigure>
        </PathGeometry>
        <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3"/>
    </GeometryGroup>

    <!-- Ayuda / signo de interrogación en círculo (Stroke) -->
    <GeometryGroup x:Key="IcoAyuda">
        <EllipseGeometry Center="12,12" RadiusX="9.5" RadiusY="9.5"/>
        <PathGeometry>
            <PathFigure StartPoint="9,9.5">
                <ArcSegment Point="15,9.5" Size="3,3" SweepDirection="Clockwise"/>
                <LineSegment Point="12,14"/>
            </PathFigure>
        </PathGeometry>
        <EllipseGeometry Center="12,17.5" RadiusX="0.9" RadiusY="0.9"/>
    </GeometryGroup>

    <!-- Lupa de búsqueda (Stroke) -->
    <GeometryGroup x:Key="IcoBuscar">
        <EllipseGeometry Center="10,10" RadiusX="6.5" RadiusY="6.5"/>
        <PathGeometry>
            <PathFigure StartPoint="15,15"><LineSegment Point="20,20"/></PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <!-- Abrir archivo / carpeta con flecha (Stroke) -->
    <PathGeometry x:Key="IcoAbrir">
        <PathFigure StartPoint="3,7" IsClosed="True">
            <LineSegment Point="10,7"/>
            <LineSegment Point="12,5"/>
            <LineSegment Point="21,5"/>
            <LineSegment Point="21,19"/>
            <LineSegment Point="3,19"/>
        </PathFigure>
        <PathFigure StartPoint="12,10"><LineSegment Point="12,16"/></PathFigure>
        <PathFigure StartPoint="9,13"><LineSegment Point="12,16"/><LineSegment Point="15,13"/></PathFigure>
    </PathGeometry>

    <!-- Guardar / disco (Stroke) -->
    <PathGeometry x:Key="IcoGuardar">
        <PathFigure StartPoint="4,4" IsClosed="True">
            <LineSegment Point="16,4"/>
            <LineSegment Point="20,8"/>
            <LineSegment Point="20,20"/>
            <LineSegment Point="4,20"/>
        </PathFigure>
        <PathFigure StartPoint="7,4"><LineSegment Point="7,9"/><LineSegment Point="15,9"/><LineSegment Point="15,4"/></PathFigure>
        <PathFigure StartPoint="7,14" IsClosed="True">
            <LineSegment Point="17,14"/>
            <LineSegment Point="17,20"/>
            <LineSegment Point="7,20"/>
        </PathFigure>
    </PathGeometry>

    <!-- Importar / bandeja con flecha hacia abajo (Stroke) -->
    <PathGeometry x:Key="IcoImportar">
        <PathFigure StartPoint="4,14"><LineSegment Point="4,20"/><LineSegment Point="20,20"/><LineSegment Point="20,14"/></PathFigure>
        <PathFigure StartPoint="12,3"><LineSegment Point="12,15"/></PathFigure>
        <PathFigure StartPoint="8,11"><LineSegment Point="12,15"/><LineSegment Point="16,11"/></PathFigure>
    </PathGeometry>

    <!-- Tema / círculo mitad (filled + outline) -->
    <GeometryGroup x:Key="IcoTema" FillRule="Nonzero">
        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
        <PathGeometry>
            <PathFigure StartPoint="12,3">
                <ArcSegment Point="12,21" Size="9,9" SweepDirection="Clockwise"/>
                <LineSegment Point="12,3"/>
            </PathFigure>
        </PathGeometry>
    </GeometryGroup>

    <!-- Más / tres puntos horizontales (filled) -->
    <GeometryGroup x:Key="IcoMas" FillRule="Nonzero">
        <EllipseGeometry Center="5,12" RadiusX="1.8" RadiusY="1.8"/>
        <EllipseGeometry Center="12,12" RadiusX="1.8" RadiusY="1.8"/>
        <EllipseGeometry Center="19,12" RadiusX="1.8" RadiusY="1.8"/>
    </GeometryGroup>

    <!-- Nuevo / símbolo + (filled) -->
    <GeometryGroup x:Key="IcoNuevo" FillRule="Nonzero">
        <RectangleGeometry Rect="10.5,4 3,16" RadiusX="1" RadiusY="1"/>
        <RectangleGeometry Rect="4,10.5 16,3" RadiusX="1" RadiusY="1"/>
    </GeometryGroup>

    <!-- Reportes / gráfico de barras (filled) -->
    <GeometryGroup x:Key="IcoReportes" FillRule="Nonzero">
        <RectangleGeometry Rect="4,14 4,8" RadiusX="1" RadiusY="1"/>
        <RectangleGeometry Rect="10,9 4,13" RadiusX="1" RadiusY="1"/>
        <RectangleGeometry Rect="16,5 4,17" RadiusX="1" RadiusY="1"/>
    </GeometryGroup>

    <!-- Flecha hacia abajo (dropdown) -->
    <PathGeometry x:Key="IcoChevronAbajo">
        <PathFigure StartPoint="4,8"><LineSegment Point="12,16"/><LineSegment Point="20,8"/></PathFigure>
    </PathGeometry>

</ResourceDictionary>
