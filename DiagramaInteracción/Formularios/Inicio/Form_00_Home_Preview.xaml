<Window x:Class="Form_00_Home_Preview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ARCO"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ARCO — Vista previa de nueva interfaz"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushFondoApp}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ARCO;component/Formularios/Inicio/Theme.Claro.xaml"/>
                <ResourceDictionary Source="/ARCO;component/Formularios/Inicio/ModuleIcons.xaml"/>
                <ResourceDictionary Source="/ARCO;component/Formularios/Inicio/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═════════════════ TOPBAR ═════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BrushTopBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Marca + sección -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0,0,0">
                    <Grid Width="32" Height="32" Margin="0,0,10,0">
                        <Ellipse Fill="{DynamicResource BrushAzulInteraccion}"/>
                        <Path Data="M 6,20 Q 16,4 26,20"
                              Stroke="White" StrokeThickness="2.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="ARCO"
                               FontFamily="{DynamicResource FuenteDisplay}"
                               FontSize="18"
                               Foreground="{DynamicResource BrushTopBarTexto}"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="24"
                               Fill="{DynamicResource BrushTopBarDivisor}"
                               Margin="16,0,16,0"/>
                    <TextBlock x:Name="LblSeccion"
                               Text="Inicio"
                               FontFamily="{DynamicResource FuenteBase}"
                               FontSize="14"
                               Foreground="{DynamicResource BrushTopBarTextoTenue}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Búsqueda -->
                <TextBox x:Name="TxtBuscar"
                         Grid.Column="1"
                         Style="{DynamicResource SearchBoxEstilo}"
                         MaxWidth="440" Width="440"
                         HorizontalAlignment="Center"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                         TextChanged="TxtBuscar_TextChanged"/>

                <!-- Acciones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{DynamicResource BtnIconoTopBar}" ToolTip="Nuevo proyecto"
                            Click="BtnNuevo_Click">
                        <Path Data="{StaticResource IcoNuevo}" Width="18" Height="18"
                              Stretch="Uniform" Fill="{DynamicResource BrushTopBarTexto}"/>
                    </Button>
                    <Button Style="{DynamicResource BtnIconoTopBar}" ToolTip="Abrir proyecto (.esm)"
                            Click="BtnAbrir_Click">
                        <Path Data="{StaticResource IcoAbrir}" Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Button>
                    <Button Style="{DynamicResource BtnIconoTopBar}" ToolTip="Guardar proyecto"
                            Click="BtnGuardar_Click">
                        <Path Data="{StaticResource IcoGuardar}" Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Button>
                    <Rectangle Width="1" Height="24" Margin="6,0,6,0"
                               Fill="{DynamicResource BrushTopBarDivisor}"/>
                    <Button Style="{DynamicResource BtnIconoTopBar}" ToolTip="Importar datos de ETABS"
                            Click="BtnImportar_Click">
                        <Path Data="{StaticResource IcoImportar}" Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Button>
                    <Button x:Name="BtnReportes" Style="{DynamicResource BtnTextoTopBar}"
                            ToolTip="Informes del proyecto" Click="BtnReportes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoReportes}" Width="16" Height="16"
                                  Stretch="Uniform" Fill="{DynamicResource BrushTopBarTexto}"
                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reportes" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IcoChevronAbajo}" Width="12" Height="12"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="2"
                                  Fill="Transparent" Margin="8,2,0,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Reporte Completo del Proyecto…" Click="MenuReporteCompleto_Click"/>
                                <MenuItem Header="Reporte de Revisión…" Click="MenuReporteRevision_Click"/>
                                <MenuItem Header="Informe Técnico Ejecutivo…" Click="MenuInformeTecnico_Click"/>
                                <Separator/>
                                <MenuItem Header="Combinar módulos desde archivo…" Click="MenuCombinar_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Rectangle Width="1" Height="24" Margin="6,0,6,0"
                               Fill="{DynamicResource BrushTopBarDivisor}"/>
                    <Button Style="{DynamicResource BtnIconoTopBar}" ToolTip="Cambiar tema (próximamente)"
                            IsEnabled="False">
                        <Path Data="{StaticResource IcoTema}" Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource BrushTopBarTextoTenue}" StrokeThickness="1.6"
                              Fill="{DynamicResource BrushTopBarTextoTenue}"/>
                    </Button>
                    <Button Style="{DynamicResource BtnIconoTopBar}" ToolTip="Ayuda"
                            Click="BtnAyuda_Click">
                        <Path Data="{StaticResource IcoAyuda}" Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.8"
                              Fill="Transparent"/>
                    </Button>
                </StackPanel>

                <!-- Controles de ventana -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Style="{DynamicResource BtnIconoTopBar}"
                            Width="46" Height="56" Click="BtnMinimize_Click" ToolTip="Minimizar">
                        <Rectangle Width="11" Height="1.5" Fill="{DynamicResource BrushTopBarTexto}"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{DynamicResource BtnIconoTopBar}"
                            Width="46" Height="56" Click="BtnMaximize_Click" ToolTip="Maximizar / Restaurar">
                        <Rectangle Width="11" Height="11"
                                   Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.3"
                                   Fill="Transparent"/>
                    </Button>
                    <Button x:Name="BtnClose" Width="46" Height="56" Click="BtnClose_Click" ToolTip="Cerrar"
                            Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent">
                                    <Grid Width="12" Height="12">
                                        <Line X1="0" Y1="0" X2="12" Y2="12"
                                              Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.3"/>
                                        <Line X1="0" Y1="12" X2="12" Y2="0"
                                              Stroke="{DynamicResource BrushTopBarTexto}" StrokeThickness="1.3"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════ CUERPO ═════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <DockPanel>
                        <!-- Pie del sidebar -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                            <Rectangle Height="1" Fill="{DynamicResource BrushSidebarSeparador}" Margin="16,12,16,8"/>
                            <Button Style="{DynamicResource SidebarItemEstilo}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{StaticResource IcoConfig}" Width="24" Height="24"
                                              Stretch="Uniform" Fill="{DynamicResource BrushSidebarTexto}"/>
                                    </Viewbox>
                                    <TextBlock Text="Configuración" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarItemEstilo}" Click="BtnAyuda_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{StaticResource IcoAyuda}" Width="24" Height="24"
                                              Stretch="Uniform" Stroke="{DynamicResource BrushSidebarTexto}"
                                              StrokeThickness="1.8" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Ayuda" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="ARCO v2.0 · Vista previa"
                                       Foreground="{DynamicResource BrushSidebarTextoTenue}"
                                       FontFamily="{DynamicResource FuenteBase}"
                                       FontSize="10"
                                       Margin="24,10,0,0"/>
                        </StackPanel>

                        <!-- Navegación principal -->
                        <StackPanel>
                            <TextBlock Text="NAVEGACIÓN" Style="{DynamicResource SidebarTituloEstilo}" Margin="24,20,16,6"/>
                            <Button Style="{DynamicResource SidebarItemEstilo}" Tag="activo">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{StaticResource IcoInicio}" Width="24" Height="24"
                                              Stretch="Uniform" Stroke="{DynamicResource BrushSidebarTexto}"
                                              StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Inicio" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarItemEstilo}" Click="BtnAbrir_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{StaticResource IcoProyecto}" Width="24" Height="24"
                                              Stretch="Uniform" Stroke="{DynamicResource BrushSidebarTexto}"
                                              StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Abrir proyecto" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarItemEstilo}" Click="BtnReportes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{StaticResource IcoInformes}" Width="24" Height="24"
                                              Stretch="Uniform" Stroke="{DynamicResource BrushSidebarTexto}"
                                              StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="Informes" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="SUPERESTRUCTURA" Style="{DynamicResource SidebarTituloEstilo}"/>
                            <ItemsControl x:Name="SidebarSuper">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource SidebarItemEstilo}" Click="SidebarModulo_Click">
                                            <TextBlock Text="{Binding Nombre}" Margin="30,0,0,0" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="CIMENTACIONES" Style="{DynamicResource SidebarTituloEstilo}"/>
                            <ItemsControl x:Name="SidebarCimen">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource SidebarItemEstilo}" Click="SidebarModulo_Click">
                                            <TextBlock Text="{Binding Nombre}" Margin="30,0,0,0" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ELEMENTOS ESPECIALES" Style="{DynamicResource SidebarTituloEstilo}"/>
                            <ItemsControl x:Name="SidebarEspec">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource SidebarItemEstilo}" Click="SidebarModulo_Click">
                                            <TextBlock Text="{Binding Nombre}" Margin="30,0,0,0" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </ScrollViewer>
            </Border>

            <!-- Contenido -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,32,40,40">
                    <!-- Encabezado -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Centro de trabajo" Style="{DynamicResource H1}"/>
                        <TextBlock Text="Análisis, diseño y revisión de estructuras de concreto."
                                   Style="{DynamicResource H1Sub}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Banner informativo -->
                    <Border Background="{DynamicResource BrushSuperficieBanner}"
                            BorderBrush="{DynamicResource BrushBorde}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18,14"
                            Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IcoAyuda}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  Stroke="{DynamicResource BrushAzulInteraccion}" StrokeThickness="1.8"
                                  Fill="Transparent"
                                  VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{DynamicResource CardTitulo}" Text="Vista previa de la nueva interfaz"/>
                                <TextBlock Style="{DynamicResource BannerTexto}" Margin="0,3,0,0"
                                           Text="La pantalla principal actual sigue funcionando con normalidad. Esta ventana es la propuesta de rediseño; revisa, pídeme ajustes y cuando esté lista la promovemos a pantalla de inicio por defecto."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Acceso rápido -->
                    <TextBlock Text="Acceso rápido" Style="{DynamicResource H2}" Margin="0,0,0,14"/>
                    <ItemsControl x:Name="ListaAccesoRapido" Margin="0,0,0,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><local:ModuleCard/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Módulos de ingeniería -->
                    <TextBlock Text="Módulos de ingeniería" Style="{DynamicResource H2}" Margin="0,8,0,0"/>

                    <TextBlock Text="SUPERESTRUCTURA"
                               FontFamily="{DynamicResource FuenteBase}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextoSecundario}"
                               Margin="0,16,0,10"/>
                    <ItemsControl x:Name="ListaSuper">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><local:ModuleCard/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="CIMENTACIONES"
                               FontFamily="{DynamicResource FuenteBase}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextoSecundario}"
                               Margin="0,16,0,10"/>
                    <ItemsControl x:Name="ListaCimen">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><local:ModuleCard/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ELEMENTOS ESPECIALES"
                               FontFamily="{DynamicResource FuenteBase}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextoSecundario}"
                               Margin="0,16,0,10"/>
                    <ItemsControl x:Name="ListaEspec">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><local:ModuleCard/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="HERRAMIENTAS"
                               FontFamily="{DynamicResource FuenteBase}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextoSecundario}"
                               Margin="0,16,0,10"/>
                    <ItemsControl x:Name="ListaTools">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><local:ModuleCard/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pie -->
                    <TextBlock Text="© 2026 EstrucMed Ingeniería Especializada"
                               Foreground="{DynamicResource BrushTextoDeshabilitado}"
                               FontFamily="{DynamicResource FuenteBase}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
